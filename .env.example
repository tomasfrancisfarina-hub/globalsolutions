# Global Solutions — Environment variables
# Copy to `.env.local` for local development.
# Configure in Vercel → Project → Settings → Environment Variables for production.

# Canonical site URL (required for production)
NEXT_PUBLIC_SITE_URL=https://globalsolutions.com

# Set to false on preview/staging to block search indexing
NEXT_PUBLIC_ALLOW_INDEXING=true

# --- Vercel Preview (temporary public URL) ---
# Preview: NEXT_PUBLIC_ALLOW_INDEXING=false
# Preview: NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Google Analytics 4 — leave empty until you have a real Measurement ID
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Google Search Console — HTML tag verification (optional)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Contact form via Resend (server-only; never use NEXT_PUBLIC_ for these)
CONTACT_EMAIL=info@globalsolutionsworldwide.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# RESEND_FROM_EMAIL must be an authorized sender or a verified domain in Resend.
# Example while testing: Global Solutions <onboarding@resend.dev>
# Example in production: Global Solutions <info@globalsolutionsworldwide.com>

